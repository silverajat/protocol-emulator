; UART receiver, 8N1, LSB first. Bit timing comes from the bit timer, locked to every falling edge.
; Config: SERIAL, IN_BASE = JMP_PIN = RESYNC_PIN = the RX pin, RESYNC_EDGE falling, IN_SHR,
;         BT_PERIOD = clock / baud, BT_POINT = BT_PERIOD / 2.
; Host: read bytes from RXF (bits [7:0]). Event 0 is set on a framing error.
.program uart_rx
    wait 1, pin, 0          ; wait for the idle level first
.wrap_target
start:
    wait 0, pin, 0          ; start bit edge (it also resyncs the bit timer)
    nop.p                   ; middle of the start bit
    in.p pins, 8            ; middle of each data bit
    jmp.p pin, good         ; middle of the stop bit
    evset 0                 ; framing error: flag it, drop the byte
    mov isr, null
    wait 1, pin, 0
    jmp start
good:
    push align              ; the byte, moved down to bits [7:0]
.wrap
