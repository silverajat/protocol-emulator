; UART transmitter, 8N1, LSB first, timed by the bit timer.
; Config: SERIAL, OUT and SET windows = the TX pin, OUT_SHR, BT_PERIOD = clock / baud
;         (BT_POINT anywhere inside the bit, e.g. the middle).
; Host: write each byte to TXF (bits [7:0]).
.program uart_tx
    set pindirs, 1          ; drive the pin (needed on uio pins; the line idles high from reset)
.wrap_target
    pull block              ; wait for a byte
    nop.p                   ; wait for a sample point: drops a stale bit-start tick
    set.p pins, 0           ; start bit, on a bit boundary
    out.p pins, 8           ; eight data bits, one per bit time
    set.p pins, 1           ; stop bit
.wrap
