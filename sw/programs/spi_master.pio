; SPI master, any mode, MSB first, BITS bits per transfer (full duplex).
; Config: SERIAL with CLK on SCK (CLK_PIN = SCK, CPOL, CPHA), DUPLEX,
;         SET window = {SCK, CS_n, MOSI} (3 pins in this order), OUT window = MOSI,
;         IN_BASE = MISO.
;         One bit takes 4 ticks (SCK = clock / (4 * (CLKDIV + 1))).
; Host: push the data left-aligned (MSB at bit 31); one word comes back with the received
;       bits right-aligned.
.program spi_master
.define BITS 24
.define IDLE 0              ; SCK level between transfers (= CPOL)
    set pindirs, 7          ; SCK, CS_n and MOSI are outputs
.wrap_target
    pull block
    set pins, IDLE          ; CS_n low
    out pins, BITS          ; clocked: MOSI out, MISO in
    set pins, 2|IDLE        ; CS_n high
    push block
.wrap
