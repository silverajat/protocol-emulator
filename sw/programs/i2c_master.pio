; I2C master with clock stretching and repeated START.
; Config: SERIAL with CLK on SCL (CLK_PIN = SCL, CPOL 0, CPHA 0), DUPLEX, STRETCH,
;         OUT window = IN_BASE = SDA, SET window = SCL, OUT_SHR 0. SDA and SCL open-drain
;         (PIN_OD) with pull-ups. One bit takes 4 ticks: 100 kHz at 60 MHz is CLKDIV = 149.
;
; The host drives it with one word per step; bits [31:26] name the step (its address,
; from the assembler's labels), and the rest is its data:
;   start  START (or repeated START), then a byte: [25:17] = the nine bits below
;   byte   one byte: [25:17] = nine bits: write = data, 1 (release SDA for the ACK)
;                                         read  = 0xFF, then the ACK to send (0 ACK, 1 NACK)
;   stop   STOP
; Every byte returns one word: the nine bits seen on SDA (write: data + the slave's ACK
; in bit 0, 0 = ACK; read: the byte from the slave + our ACK).
.program i2c_master
.define D 3
.define SCL 1               ; input-space index of SCL (for the START/STOP waits)
.wrap_target
top:
    pull block
    out pc, 6               ; jump to the step the host asked for
start:
    mov pins, ~null [D]     ; SDA released
    set pins, 1 [D]         ; SCL released
    wait 1, gpio, SCL
    mov pins, null [D]      ; SDA falls while SCL is high: START (then the byte)
byte:
    out pins, 9             ; nine clocked bits; SDA is sampled into ISR at the same time
    push block
    jmp top
stop:
    mov pins, null [D]      ; SDA low (SCL is low after a byte)
    set pins, 1 [D]         ; SCL released
    wait 1, gpio, SCL
    mov pins, ~null [D]     ; SDA rises while SCL is high: STOP
.wrap
