# Longest path in logic levels (generic gates), with signal names: mkdir -p build; yowasp-yosys -q tools/depth.ys; cat build/depth.txt
read_verilog -Isrc src/project.v src/host_spi.v src/pe_core.v src/pe_engine.v src/pe_fifo.v
synth -top tt_um_silverajat_protoemu -flatten -noshare
abc -g AND,NAND,OR,NOR,XOR,XNOR,ANDNOT,ORNOT,MUX,AOI3,OAI3,AOI4,OAI4
opt_clean
tee -q -o build/depth.txt ltp -noff
